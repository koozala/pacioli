<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup Label="Globals">
	  <WebView2LoaderPreference>Dynamic</WebView2LoaderPreference>
	</PropertyGroup>

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows7.0</TargetFramework>
		<Nullable>enable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
		<ApplicationIcon>Pacioli_64.ico</ApplicationIcon>
		<AssemblyName>Pacioli</AssemblyName>
		<AssemblyVersion>1.34.0</AssemblyVersion>
		<Deterministic>false</Deterministic>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="Pacioli_64.ico" />
	</ItemGroup>

	<!--
		The logo of the start screen.

		The picture is part of the assembly, thus the application needs no other file at
		the side of the program. LogicalName gives a name that does not change if the
		name of the file changes. The class LogoPanel reads the picture under that name.
	-->
	<ItemGroup>
		<EmbeddedResource Include="Assets\Pacilio-Logo-Cut.svg" LogicalName="Pacioli.WindowsApp.Assets.Logo.svg" />
	</ItemGroup>

	<!--
		Removes the WPF control of WebView2.

		The file Common.targets of the package Microsoft.Web.WebView2 adds three
		assemblies to each project of net5.0 or later: Core, WinForms, and Wpf. It does
		not look at UseWPF. This application uses Windows Forms, thus it never uses the
		WPF control. But the WPF assembly needs WindowsBase 5.0.0.0, and a project
		without WPF has WindowsBase 4.0.0.0 only. The build then gives the warning
		MSB3277 about a conflict of two versions.

		The target removes the assembly that the application does not use. Thus the
		conflict goes away. Do not use Microsoft.Web.WebView2.Wpf in this project.

		The target must come after the import of the package, thus it is a target and
		not an ItemGroup of the project.
	-->
	<Target Name="RemoveWebView2WpfReference" BeforeTargets="ResolveAssemblyReferences">
		<ItemGroup>
			<Reference Remove="@(Reference-&gt;WithMetadataValue('Filename', 'Microsoft.Web.WebView2.Wpf'))" />
		</ItemGroup>
	</Target>

	<ItemGroup>
		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
		<PackageReference Include="PDFtoImage" Version="5.3.0" />
	</ItemGroup>

	<!--
		This project does not name a parser. It uses InvoiceWriter of Pacioli.Pdf, and
		that project brings the parser with it.
	-->


	<ItemGroup>
		<ProjectReference Include="..\Pacioli.Config.Persistence\Pacioli.Config.Persistence.csproj" />
		<ProjectReference Include="..\Pacioli.Language\Pacioli.Language.csproj" />
		<ProjectReference Include="..\Pacioli.Pdf\Pacioli.Pdf.csproj" />
		<ProjectReference Include="..\Pacioli.Preview\Pacioli.Preview.csproj" />
		<ProjectReference Include="..\Pacioli.Updater\Pacioli.Updater.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="MainForm.cs" />
		<Compile Update="Properties\Settings.Designer.cs">
		  <DesignTimeSharedInput>True</DesignTimeSharedInput>
		  <AutoGen>True</AutoGen>
		  <DependentUpon>Settings.settings</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<!--
			The file names the version of this program. The class VersionInformation reads
			it at the side of the program, thus it must go into the output folder and into
			the folder of the installation.
		-->
		<None Update="version.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Pacioli_64.ico">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Properties\Settings.settings">
		  <Generator>SettingsSingleFileGenerator</Generator>
		  <LastGenOutput>Settings.Designer.cs</LastGenOutput>
		</None>
	</ItemGroup>

</Project>