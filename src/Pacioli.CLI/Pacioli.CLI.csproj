<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net10.0 comes from Pacioli.Pdf. See the note in Pacioli.Pdf.csproj. -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>pacioli-cmd</AssemblyName>
    <Version>0.14</Version>
  </PropertyGroup>

  <!--
    This project does not name a parser. It uses InvoiceWriter and ZugferdExtractor of
    Pacioli.Pdf, and that project brings the parser with it.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Pacioli.Pdf\Pacioli.Pdf.csproj" />
  </ItemGroup>

</Project>
