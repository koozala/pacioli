<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net10.0 is necessary: the package Vit.FeRD.ExtendedDocument has a
      lib folder for net10.0 only.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="itext" Version="9.6.0" />
    <PackageReference Include="itext.bouncy-castle-adapter" Version="9.6.0" />
    <PackageReference Include="Vit.FeRD.ExtendedDocument" Version="0.0.1-5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pacioli.Language\Pacioli.Language.csproj" />
  </ItemGroup>

</Project>
