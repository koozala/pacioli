<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0 comes from Pacioli.Pdf. See the note in Pacioli.Pdf.csproj. -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageReference Include="NUnit" Version="4.6.0" />
    <PackageReference Include="NUnit.Analyzers" Version="4.13.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
  </ItemGroup>

  <!--
    The content check reads the text of the rendered PDF with iText. It reads the
    expected values with the FeRD library. The versions must stay equal to the
    versions in Pacioli.Pdf.
  -->
  <ItemGroup>
    <PackageReference Include="itext" Version="9.6.0" />
    <PackageReference Include="itext.bouncy-castle-adapter" Version="9.6.0" />
    <PackageReference Include="Vit.FeRD.ExtendedDocument" Version="0.0.1-7" />
  </ItemGroup>

  <!--
    The test starts pacioli-cmd.exe as a separate process.
    ReferenceOutputAssembly is false. The reference only makes sure that the CLI
    is built before the test runs. It does not add the CLI assembly to the test.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Pacioli.CLI.NET8\Pacioli.CLI.NET8.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <!-- The content check reads the sample data with the ZUGFeRD reader of Pacioli.Pdf. -->
  <ItemGroup>
    <ProjectReference Include="..\Pacioli.Pdf\Pacioli.Pdf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="testsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

</Project>
